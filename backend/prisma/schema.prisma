generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  vendeur
  client
}

enum SellerVerificationStatus {
  non_soumise
  en_attente
  approuvee
  rejetee
}

enum PlanTier {
  standard
  pro
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  phone                    String?
  passwordHash             String
  accountType              AccountType               @default(vendeur)
  createdAt                DateTime                  @default(now())
  products                 Product[]
  buyerConversations       Conversation[]            @relation("BuyerConversations")
  vendorConversations      Conversation[]            @relation("VendorConversations")
  messages                 ChatMessage[]
  buyerOrders              Order[]                   @relation("BuyerOrders")
  vendorOrders             Order[]                   @relation("VendorOrders")
  sellerVerificationStatus SellerVerificationStatus  @default(non_soumise)
  sellerVerificationRectoUrl  String?
  sellerVerificationVersoUrl  String?
  sellerVerificationSelfieUrl String?
  sellerVerificationReason    String?
  buyerReviews             Review[]                  @relation("BuyerReviews")
  vendorReviews            Review[]                  @relation("VendorReviews")
  planTier                 PlanTier                  @default(standard)
  planPeriodEnd            DateTime?
  payments                 Payment[]
  reports                  Report[]                  @relation("Reports")
  analyticsSessions        AnalyticsSession[]
  passwordResetTokens      PasswordResetToken[]

  /// Boutique personnalisable (réservé aux vendeurs Pro)
  storeName        String?
  storeDescription String?
  storeLogoUrl     String?
  storeBannerUrl   String?

  /// Parrainage
  referralCode   String?    @unique
  referralsMade  Referral[] @relation("ReferralsMade")
  referralOf     Referral[] @relation("ReferralOf")

  /// Cagnotte d'affiliation (FCFA) : gains cumulés, dépensables ou retirables
  walletBalance   Int              @default(0)
  referralRewards ReferralReward[] @relation("ReferralRewardsEarned")
  withdrawals     Withdrawal[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SentEmail {
  id               String   @id @default(uuid())
  sentByAdminId    String
  subject          String
  body             String
  recipientFilter  String
  recipientCount   Int
  createdAt        DateTime @default(now())
}

enum ProductCategory {
  mode_beaute
  electronique
  maison
  telephones
  alimentation
  autre
}

model Product {
  id            String          @id @default(uuid())
  vendorId      String
  vendor        User            @relation(fields: [vendorId], references: [id])
  title           String
  description     String
  deliveryInfo    String?
  price           Int
  shippingFee     Int             @default(0)
  discountPercent Int?
  category        ProductCategory
  photos          String[]
  createdAt       DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  conversations Conversation[]
  orders        Order[]
}

model Conversation {
  id        String        @id @default(uuid())
  buyerId   String
  buyer     User          @relation("BuyerConversations", fields: [buyerId], references: [id])
  vendorId  String
  vendor    User          @relation("VendorConversations", fields: [vendorId], references: [id])
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  messages  ChatMessage[]
  createdAt DateTime      @default(now())

  @@unique([buyerId, vendorId, productId])
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  offerPrice     Int?
  createdAt      DateTime     @default(now())
  order          Order?
}

enum OrderStatus {
  en_attente_paiement
  paye
  expedie
  confirme
  en_litige
  rembourse
}

model Order {
  id               String      @id @default(uuid())
  buyerId          String
  buyer            User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  vendorId         String
  vendor           User        @relation("VendorOrders", fields: [vendorId], references: [id])
  productId        String
  product          Product     @relation(fields: [productId], references: [id])
  quantity         Int         @default(1)
  chatMessageId    String?      @unique
  chatMessage      ChatMessage? @relation(fields: [chatMessageId], references: [id])
  checkoutRef      String
  price            Int
  commissionAmount Int
  netAmount        Int
  status           OrderStatus @default(en_attente_paiement)
  paymentReference String      @unique
  confirmationCode String
  shipBy           DateTime?
  confirmBy        DateTime?
  shippedAt        DateTime?
  trackingNumber   String?
  carrier          String?
  disputeReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  review           Review?

  @@index([checkoutRef])
  @@index([vendorId])
  @@index([buyerId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  buyerId   String
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id])
  vendorId  String
  vendor    User     @relation("VendorReviews", fields: [vendorId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

enum PaymentStatus {
  pending
  paid
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  reference String        @unique
  amount    Int
  status    PaymentStatus @default(pending)
  createdAt DateTime      @default(now())
}

enum ReportTargetType {
  produit
  utilisateur
  message
}

enum ReportStatus {
  en_attente
  traite
  rejete
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  reporter   User             @relation("Reports", fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(en_attente)
  adminNote  String?
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

model AnalyticsSession {
  id              String           @id @default(uuid())
  visitorId       String
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  deviceType      String?
  browser         String?
  os              String?
  country         String?
  city            String?
  ipHash          String?
  referrer        String?
  entryPath       String?
  exitPath        String?
  startedAt       DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  durationSeconds Int              @default(0)
  isReturning     Boolean          @default(false)
  events          AnalyticsEvent[]

  @@index([visitorId])
  @@index([userId])
  @@index([startedAt])
}

model AnalyticsEvent {
  id        String           @id @default(uuid())
  sessionId String
  session   AnalyticsSession @relation(fields: [sessionId], references: [id])
  type      String
  path      String?
  targetId  String?
  message   String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([sessionId])
  @@index([type, createdAt])
  @@index([path])
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
}

enum ReferralStatus {
  pending
  signed_up
  purchased
}

enum RewardStatus {
  pending
  credited
}

model Referral {
  id             String         @id @default(uuid())
  referrerId     String
  referrer       User           @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredEmail  String
  status         ReferralStatus @default(pending)
  referredUserId String?
  referredUser   User?          @relation("ReferralOf", fields: [referredUserId], references: [id])
  rewardStatus   RewardStatus   @default(pending)
  rewardAmount   Int            @default(0)
  /// Début de la fenêtre d'affiliation vendeur (1re vente du filleul vendeur)
  vendorWindowStartsAt DateTime?
  rewards        ReferralReward[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([referrerId])
  @@index([referredEmail])
  @@index([status])
}

enum ReferralRewardKind {
  buyer_first_purchase
  vendor_sale
}

/// Un gain d'affiliation crédité (1 ligne par commande récompensée → idempotent).
model ReferralReward {
  id         String             @id @default(uuid())
  referralId String
  referral   Referral           @relation(fields: [referralId], references: [id])
  referrerId String
  referrer   User               @relation("ReferralRewardsEarned", fields: [referrerId], references: [id])
  orderId    String
  amount     Int
  kind       ReferralRewardKind
  createdAt  DateTime           @default(now())

  /// Idempotence : au plus une récompense par commande ET par type (acheteur / vendeur).
  @@unique([orderId, kind])
  @@index([referrerId])
  @@index([referralId])
}

enum WithdrawalMethod {
  wave
  orange_money
  mtn
}

enum WithdrawalStatus {
  pending
  paid
  rejected
}

/// Demande de retrait de cagnotte vers un compte Mobile Money.
model Withdrawal {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  amount      Int
  method      WithdrawalMethod
  phone       String
  status      WithdrawalStatus @default(pending)
  createdAt   DateTime         @default(now())
  processedAt DateTime?

  @@index([userId])
  @@index([status])
}
